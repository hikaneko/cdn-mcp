# Akamai EdgeGrid credentials (from your .edgerc [default] section, or
# Control Center > Identity & Access Management > API Users). Set these as
# secrets in the Zuplo portal (Settings > Environment Variables), per
# environment (Working Copy / Preview / Production don't share values) -
# and redeploy after any change for it to take effect.
EDGERC_CLIENT_TOKEN=akab-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx
EDGERC_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
EDGERC_ACCESS_TOKEN=akab-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# Bare hostname only, no scheme (e.g. xxxx-xxxxxxx-xxxxxxxxxxxxx.luna.akamaiapis.net)
EDGERC_HOST=xxxx-xxxxxxx-xxxxxxxxxxxxx.luna.akamaiapis.net

# IPs allowed to call /mcp (ip-address-restriction-inbound policy)
ALLOWED_IP_1=203.0.113.10
ALLOWED_IP_2=203.0.113.11
