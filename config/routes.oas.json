  "paths": {
    "/delete/url/{network}": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Fast Purge: Delete by URL",
        "description": "Immediately removes the given URLs/ARLs from the Akamai cache on the selected network, so the next request goes to origin. This affects live production traffic immediately if network=production - confirm with the user before calling with network=production. Prefer invalidate-by-url unless you specifically need immediate removal, since delete causes a full origin fetch on next request while invalidate allows stale-while-revalidate.",
        "operationId": "delete-by-url",
        "tags": [
          "Fast Purge"
        ],
        "parameters": [
          {
            "name": "network",
            "in": "path",
            "required": true,
            "description": "Network to purge on. Defaults to production.",
            "schema": {
              "type": "string",
              "enum": [
                "staging",
                "production"
              ],
              "default": "production"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "objects"
                ],
                "properties": {
                  "objects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of URLs or ARLs to delete from cache, e.g. https://www.example.com/path/file.js"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Purge request accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://${env.EDGERC_HOST}/ccu/v3"
            }
          },
          "policies": {
            "inbound": [
              "edgegrid-signing-ccu-inbound"
            ]
          },
          "mcp": {
            "type": "tool"
          }
        }
      }
    },
    "/invalidate/url/{network}": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Fast Purge: Invalidate by URL",
        "description": "Marks the given URLs/ARLs as stale on the selected network so Akamai re-validates them against origin on next request, rather than deleting them outright. Prefer this over delete-by-url unless you specifically need immediate removal. This affects live production traffic immediately if network=production - confirm with the user before calling with network=production.",
        "operationId": "invalidate-by-url",
        "tags": [
          "Fast Purge"
        ],
        "parameters": [
          {
            "name": "network",
            "in": "path",
            "required": true,
            "description": "Network to invalidate on. Defaults to production.",
            "schema": {
              "type": "string",
              "enum": [
                "staging",
                "production"
              ],
              "default": "production"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "objects"
                ],
                "properties": {
                  "objects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of URLs or ARLs to invalidate, e.g. https://www.example.com/path/file.js"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Purge request accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://${env.EDGERC_HOST}/ccu/v3"
            }
          },
          "policies": {
            "inbound": [
              "edgegrid-signing-ccu-inbound"
            ]
          },
          "mcp": {
            "type": "tool"
          }
        }
      }
    },
    "/rate-limit-status/{purge-type}": {
      "x-zuplo-path": {
        "pathMode": "open-api"
      },
      "post": {
        "summary": "Fast Purge: Check Rate-Limit Status",
        "description": "Returns the account's remaining Fast Purge request/object rate-limit tokens for the given purge-object type. This does NOT check the status of a specific past purge by ID - Akamai's Fast Purge v3 API has no such endpoint, and purge completion isn't independently queryable. Use the estimatedSeconds field returned by delete-by-url/invalidate-by-url itself as the completion estimate.",
        "operationId": "check-purge-rate-limit-status",
        "tags": [
          "Fast Purge"
        ],
        "parameters": [
          {
            "name": "purge-type",
            "in": "path",
            "required": true,
            "description": "Which purge object type's rate-limit bucket to check.",
            "schema": {
              "type": "string",
              "enum": [
                "cpcode",
                "tag",
                "url"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Rate limit status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "https://${env.EDGERC_HOST}/ccu/v3"
            }
          },
          "policies": {
            "inbound": [
              "edgegrid-signing-ccu-inbound"
            ]
          },
          "mcp": {
            "type": "tool"
          }
        }
      }
    },
