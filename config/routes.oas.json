    "/mcp": {
      "post": {
        "summary": "Akamai CDN MCP Server",
        "description": "Exposes Akamai Fast Purge (CCU v3) and Property Manager (PAPI v1, read-only) as MCP tools. Credentials are configured server-side via Zuplo environment variables; MCP clients need no Akamai credentials of their own.",
        "operationId": "akamai-cdn-mcp-server",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "mcpServerHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "name": "akamai-cdn-mcp",
              "version": "0.1.0",
              "operations": [
                {
                  "file": "./config/routes.oas.json",
                  "id": "delete-by-url"
                },
                {
