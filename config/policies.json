{
  "policies": [
    {
      "name": "edgegrid-signing-ccu-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/edgegrid-signing-inbound)",
        "options": {
          "apiPathPrefix": "/ccu/v3"
        }
      }
    },
    {
      "name": "edgegrid-signing-papi-inbound",
      "policyType": "custom-code-inbound",
      "handler": {
        "export": "default",
        "module": "$import(./modules/edgegrid-signing-inbound)",
        "options": {
          "apiPathPrefix": "/papi/v1"
        }
      }
    },
    {
      "handler": {
        "export": "AuditLogInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "eventTypeBase": "com.akamai.cdn",
          "include": {
            "geolocation": true,
            "ipAddress": true,
            "queryParams": true,
            "user": true
          },
          "samplingRate": 1
        }
      },
      "name": "audit-log-inbound",
      "policyType": "audit-log-inbound"
    },
    {
      "handler": {
        "export": "IpAddressRestrictionInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allow": [
            "$env(ALLOWED_IP_1)",
            "$env(ALLOWED_IP_2)"
          ]
        }
      },
      "name": "ip-address-restriction-inbound",
      "policyType": "ip-address-restriction-inbound"
    }
  ]
}